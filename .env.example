# PostgreSQL — used by Docker Compose to init the DB and by Prisma via DATABASE_URL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=fileshare

# Prisma connection string (uses localhost for native dev; Docker Compose overrides this)
DATABASE_URL=postgresql://postgres:secret@localhost:5432/fileshare

# MinIO credentials (must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Internal endpoint — used by the NestJS API to talk to MinIO
# Docker Compose overrides this to http://minio:9000 (internal service name)
MINIO_ENDPOINT=http://localhost:9000

# Public endpoint — used to generate presigned URLs the browser can reach
# Keep as localhost for both native dev and Docker Compose
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# MinIO bucket name (create this bucket manually on first run via http://localhost:9001)
MINIO_BUCKET=files

# JWT signing secret — change this to a long random string in production
JWT_SECRET=changeme
